   "source": [
    "reader = pv.CGNSReader('out/temp.cgns')\n",
    "msh = reader.read()\n",
    "plotter = pv.Plotter()\n",
    "\n",
    "print(msh)\n",
    "\n",
    "plotter.add_mesh(msh, show_edges=True, scalars='Temperature')\n",
    "plotter.camera_position = 'xy'\n",
    "plotter.show_axes()\n",
    "plotter.show(jupyter_backend='static')"
